# ==========================================================================
# JLS Photography — production environment template
# Copy to `.env` (or your platform's secret store) on the host. Never commit
# the real `.env`. All REQUIRED values must be set before first boot.
#
# NOTE: SMTP / site URL / contact & social info / brand copy are NOT here —
# they live in the DB `settings` table and are edited from the admin panel
# (Admin -> Settings). On a fresh host the DB seeds sensible defaults; set
# the real values once in the admin panel after first boot.
# ==========================================================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Storage (REQUIRED — where SQLite + uploads live on this host) ---
# Use a persistent disk/volume path. Default (repo-local) is fine for a
# single VPS that is backed up; prefer an attached volume for managed hosts.
DB_PATH=/srv/jls/data/photography.db
UPLOADS_DIR=/srv/jls/uploads

# --- Auth (REQUIRED) ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_48_byte_random_hex
# Optional: default 7d
# JWT_EXPIRES_IN=7d

# --- Admin bootstrap (ONLY used when the admins table is empty / fresh DB) ---
# After your first successful login, change the password in Admin -> Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- SITE_URL — optional embedding / external-link absolute host ---
# SITE_URL=https://jls.example.com
